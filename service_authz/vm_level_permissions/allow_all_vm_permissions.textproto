# proto-file: system/software_defined_vehicle/middleware/service_authz/proto/vm_authz_policy.proto
# proto-message: VmAuthzPolicy

# Allow all communication from all VMs.

allow_publisher { message: "*" topic: "*" }
allow_subscriber { message: "*" topic: "*" }
allow_server { service: "*" channel: "*" }
allow_client { service: "*" channel: "*" }
