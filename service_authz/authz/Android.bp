package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_authz@rust_defaults",
    crate_name: "sdv_authz",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    srcs: ["src/lib.rs"],
    rustlibs: [
        // keep-sorted start
        "google.sdv.identity-V2-rust",
        "google.sdv.service_discovery.common-V2-rust",
        "google.sdv.service_discovery.discovery-V2-rust",
        "libanyhow",
        "liblog_rust",
        "libprotobuf",
        "libsdv_authz_policy",
        "libsdv_authz_policy_proto_rust",
        "libsdv_comms_id",
        "libsdv_comms_sd",
        "libsdv_middleware_flags",
        // keep-sorted end
    ],
}

rust_library {
    name: "libsdv_authz",
    defaults: ["sdv_authz@rust_defaults"],
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_middleware_unit_authz_test",
    defaults: ["sdv_authz@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    rustlibs: [
        "google.sdv.service_discovery.common-V2-rust",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
