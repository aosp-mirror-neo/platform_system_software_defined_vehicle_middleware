# proto-file:
# //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

acls {
    name: "Writers"
    include: "com.google.android.sdv.datatunnel.*"
}
acls {
    name: "Readers"
    include: "some-vm:*"
}

unit_types {
    name: "SystemExtTopic"
    acl_names: "Writers"
}

service_units {
    name: "system-ext-service-unit"
    acl_names: "Readers"
}
