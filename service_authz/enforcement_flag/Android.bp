package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_authz_enforcement_flag@rust_defaults",
    crate_name: "sdv_authz_enforcement_flag",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        "libanyhow",
        "liblog_rust",
        "librustutils",
        "libsdv_authz",
    ],
}

rust_library {
    name: "libsdv_authz_enforcement_flag",
    defaults: ["sdv_authz_enforcement_flag@rust_defaults"],
    srcs: ["src/lib.rs"],
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_mt_core_services_integration_authz_enforcement_flag_default_test",
    srcs: ["tests/authz_enforcement_flag_default_test.rs"],
    defaults: ["sdv_authz_enforcement_flag@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: false,
    },
    require_root: true,
    auto_gen_config: true,
    compile_multilib: "first",
    rustlibs: [
        "libsdv_authz_enforcement_flag",
    ],
}

rust_test {
    name: "sdv_mt_core_services_integration_authz_enforcement_flag_enabled_test",
    srcs: ["tests/authz_enforcement_flag_enabled_test.rs"],
    defaults: ["sdv_authz_enforcement_flag@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: false,
    },
    require_root: true,
    auto_gen_config: true,
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
    compile_multilib: "first",
    rustlibs: [
        "libsdv_authz_enforcement_flag",
    ],
}
