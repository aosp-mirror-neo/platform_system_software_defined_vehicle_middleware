package {
    default_applicable_licenses: ["sdv_license"],
}

// Authz test of the service bundle shared library written in Rust.
rust_ffi_shared {
    name: "liboem_authz_service_bundle_test",
    srcs: ["src/lib.rs"],
    crate_name: "oem_authz_service_bundle_test",
    rustlibs: [
        "libanyhow",
        "libsdv_lifecycle_client_rust",
        "liblog_rust",
        "libsdv_comms_rs",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],

    product_specific: true,
}
