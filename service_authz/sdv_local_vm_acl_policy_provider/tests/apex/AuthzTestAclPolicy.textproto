# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# Units Types.
acls {
    name: "TirePressurePubs1"
    include: "vm-cdc:*"
    include: "vm-telemetry:*"
    never_include: "vm-ivi:*"
}
acls {
    name: "TirePressurePubs2"
    include: "com.google.android.sdv.datatunnel.*"
}
unit_types {
    name: "TirePressureTopic1"
    acl_names: "TirePressurePubs2"
}
unit_types {
    name: "TirePressureTopic2"
    acl_names: "TirePressurePubs1"
    acl_names: "TirePressurePubs2"
}

# Service Units.
acls {
    name: "TirePressureSubs1"
    include: "vm-cdc:*"
    include: "vm-telemetry:*"
    never_include: "vm-ivi:*"
}
acls {
    name: "TirePressureSubs2"
    include: "com.google.android.sdv.datatunnel.*"
}
service_units {
    name: "tire-pressure-publisher-1"
    acl_names: "TirePressureSubs2"
}
service_units {
    name: "tire-pressure-publisher-2"
    acl_names: "TirePressureSubs1"
    acl_names: "TirePressureSubs2"
}
