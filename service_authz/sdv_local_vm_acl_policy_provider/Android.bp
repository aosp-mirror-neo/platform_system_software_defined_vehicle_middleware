package {
    default_applicable_licenses: ["sdv_license"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_authz_sdv_local_vm_acl_policy_provider@rust_defaults",
    crate_name: "sdv_authz_sdv_local_vm_acl_policy_provider",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        "libsdv_authz_acl_file_provider",
        "libanyhow",
        "liblog_rust",
        "libbinder_rs",
        "libprotobuf",
        "librustutils",
        "libsdv_authz",
        "libsdv_authz_policy",
        "libsdv_authz_policy_proto_rust",
        "libsdv_comms_id",
        "google.sdv.service_bundles_registry-V2-rust",
    ],
}

rust_library {
    name: "libsdv_authz_sdv_local_vm_acl_policy_provider",
    defaults: ["sdv_authz_sdv_local_vm_acl_policy_provider@rust_defaults"],
    srcs: ["src/lib.rs"],
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_core_services_integration_authz_local_vm_acl_policy_provider_test",
    srcs: ["tests/sdv_local_vm_acl_policy_provider_test.rs"],
    defaults: ["sdv_authz_sdv_local_vm_acl_policy_provider@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: false,
    },
    rustlibs: [
        "libsdv_authz_local_vm_acl_policy_provider_factory",
    ],
    auto_gen_config: true,
    compile_multilib: "first",
    system_ext_specific: true,
    prefer_rlib: true,
    // Requires root so the test can perform Binder calls to the SBR.
    require_root: true,
}

rust_test {
    name: "sdv_core_core_services_unit_sdv_local_vm_acl_policy_provider",
    defaults: ["sdv_authz_sdv_local_vm_acl_policy_provider@rust_defaults"],
    srcs: ["src/lib.rs"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
