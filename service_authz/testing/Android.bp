package {
    default_applicable_licenses: ["sdv_license"],
}

// Authz testing service bundle libraries defaults.
rust_defaults {
    name: "tests_authz_service_bundle@defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        // Contains all SDV libraries accessed from the user code.
        "libsdv_rs",
        // Rust Protobuf library.
        "libprotobuf",
        // Rust lightweight logging *facade*.
        "liblog_rust",
        // Tokio coroutines.
        "libtokio",
        "libtokio_util",
        // Rust foundations for asynchronous programming.
        "libfutures",
        // Idiomatic error handling in Rust.
        "libanyhow",
    ],
    proc_macros: [
        // Type erasure for async trait methods.
        "libasync_trait",
    ],
    // CUJs service bundles are to be packed into /product apexes.
    product_specific: true,
    // SDK version when the library was introduced. Enables apexes with this library to be updatable.
    min_sdk_version: "35",
}
