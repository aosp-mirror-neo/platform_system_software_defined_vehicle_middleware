# proto-file:
# //system/software_defined_vehicle/service_bundles_registry/proto/sdv_service_bundles_manifest.proto
# proto-message: SdvServiceBundleManifestEntry

sdv_service_bundle_metadata {
  # Service bundle name.
  name: "AuthzTestDriver"
  # Service Bundle Version Number.
  version_number: 1
  # Service Bundle Version Name.
  version_name: "1.0"
  # Path to the native library to be loaded as service bundle.
  native_library_path: "lib64/libauthz_test_driver.so"
  # Path to the orchestration config file.
  orchestration_config_path: "etc/orch/authz_test_driver_orch.textproto"
  # Path to the ACLs policy file.
  access_control_list_policy_path: "etc/acls/authz_test_driver_acls.textproto"
}
