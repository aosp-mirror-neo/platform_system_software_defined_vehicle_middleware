# proto-file:
# //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/authz_policy.proto
# proto-message: AuthzPolicy

# ------------------------------ DT ------------------------------

publisher {
  message: "com.android.sdv.test.permissions.foo.PingDtPublisherUnitType"
  topic: "ping-dt-publisher"
  topic: "ping-dt-publisher-non-connectable"
}

subscriber {
  message: "com.android.sdv.test.permissions.foo.PingDtPublisherUnitType"
  topic: "ping-dt-publisher-non-connectable"
}

# ------------------------------ RPC ------------------------------

server {
  service: "com.android.sdv.test.permissions.foo.EchoRpcServerUnitType"
  channel: "echo-rpc-server"
  channel: "echo-rpc-server-non-connectable"
}

# Authorize only AuthzTestedService service bundle to get SID of
# the non-connectable RPC server.
#
# Later SID will be used by AuthzTestDriver service bundle to directly
# connect to the non-connectable RPC server
client {
  service: "com.android.sdv.test.permissions.foo.EchoRpcServerUnitType"
  channel: "echo-rpc-server-non-connectable"
}
