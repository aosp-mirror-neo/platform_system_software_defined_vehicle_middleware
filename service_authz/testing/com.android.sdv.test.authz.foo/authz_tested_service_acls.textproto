# proto-file:
# //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ------------------------------ DT ------------------------------

acls {
    name: "ping-dt-publisher-unit-type-acl"
    include: "com.android.sdv.test.authz.foo.AuthzTestedService"
}

unit_types {
    name: "PingDtPublisherUnitType"
    acl_names: "ping-dt-publisher-unit-type-acl"
}

acls {
    name: "ping-dt-publisher-acl"
    include: "com.android.sdv.test.authz.bar.AuthzTestDriver"
}

service_units {
    name: "ping-dt-publisher"
    acl_names: "ping-dt-publisher-acl"
}

acls {
    name: "ping-dt-publisher-non-connectable-acl"
    # Authorize only AuthzTestedService service bundle to get SID of
    # the non-connectable DT publisher.
    #
    # Later SID will be used by AuthzTestDriver service bundle to directly
    # connect to the non-connectable DT publisher
    include: "com.android.sdv.test.authz.foo.AuthzTestedService"
}

service_units {
    name: "ping-dt-publisher-non-connectable"
    acl_names: "ping-dt-publisher-non-connectable-acl"
}

# ------------------------------ RPC ------------------------------

acls {
    name: "echo-rpc-server-unit-type-acl"
    include: "com.android.sdv.test.authz.foo.AuthzTestedService"
}

unit_types {
    name: "EchoRpcServerUnitType"
    acl_names: "echo-rpc-server-unit-type-acl"
}

acls {
    name: "echo-rpc-server-acl"
    include: "com.android.sdv.test.authz.bar.AuthzTestDriver"
}

service_units {
    name: "echo-rpc-server"
    acl_names: "echo-rpc-server-acl"
}

acls {
    name: "echo-rpc-server-non-connectable-acl"
    # Authorize only AuthzTestedService service bundle to get SID of
    # the non-connectable RPC server.
    #
    # Later SID will be used by AuthzTestDriver service bundle to directly
    # connect to the non-connectable RPC server
    include: "com.android.sdv.test.authz.foo.AuthzTestedService"
}

service_units {
    name: "echo-rpc-server-non-connectable"
    acl_names: "echo-rpc-server-non-connectable-acl"
}
