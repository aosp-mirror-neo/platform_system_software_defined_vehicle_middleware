package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_test {
    name: "sdv_core_core_services_unit_vsidl_proto_reflection_performance_test",
    defaults: [
        "sdv_core_core_services_unit_vsidl_e2e_defaults",
        "sdv_tracing@rust_defaults",
    ],
    srcs: ["proto_repeated_nested_test_message_test.rs"],
    rustlibs: [
        "libsdv_proto_reflection_rs",
        "libsdv_proto_test_messages",
        "libprotobuf",
        "liblog_rust",
        "libsdv_rs",
        "libtokio",
        "libfutures",
        "libgoogletest_rust",
        "libvsidl_v1_stdlib_proto_rs",
    ],
}
