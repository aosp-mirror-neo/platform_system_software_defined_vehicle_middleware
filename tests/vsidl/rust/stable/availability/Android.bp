package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_test {
    name: "sdv_core_middleware_unit_vsidl_availability_stable_e2e_test",
    defaults: [
        "sdv_core_middleware_unit_vsidl_pubsub_stable_e2e_defaults",
        "sdv_core_middleware_unit_vsidl_multipub_stable_e2e_defaults",
    ],
    srcs: ["availability_test.rs"],
    rustlibs: [
        "libbinder_rs",
    ],
}

rust_test {
    name: "sdv_core_middleware_unit_vsidl_availability_rpc_stable_e2e_test",
    defaults: ["sdv_core_middleware_unit_vsidl_e2e_defaults"],
    srcs: ["availability_rpc_test.rs"],
    rustlibs: [
        "libsdv_mw_rs_sdv_vsidl_test_stable_rpc_tire_status_consumer",
        "libsdv_mw_rs_sdv_vsidl_test_stable_rpc_tire_status_producer",
        "libsdv_vsidl_test_stable_rpc_tire_status_rpc_rs",
        "libvsidl_test_stable_rpc_protos",
        "libprotobuf",
        "liblog_rust",
        "libsdv_rs",
        "libtokio",
        "libfutures",
        "libgoogletest_rust",
        "libbinder_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],

}
