rust_defaults {
    name: "sdv_core_middleware_unit_vsidl_e2e_defaults",
    defaults: ["sdv@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
    ],

    // Ensure End-to-End test work on product and vendor partitions.
    // https://source.android.com/docs/core/architecture/partitions/product-interfaces#native-interfaces
    vendor_available: true,
    product_available: true,

    // All end-to-end tests in this directory are unit tests
    test_options: {
        unit_test: true,
    },

    // TODO(398771552): Remove authz disabling exception. This should not be used in the new code.
    test_config_template: ":sdv_authz_enforcement_flag_disabled_config_template",

    // End-to-end tests link to CommsStack C-API layer
    ld_flags: ["-Wl,--no-as-needed"],
}
