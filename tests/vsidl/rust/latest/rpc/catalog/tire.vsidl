# proto-file: system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.vsidl.rpc.test"

service_bundle {
  name: "TireStatusProducer"
  server {
    service: "TireStatus"
    channel: "tire-status-unary"
    service_unit_name: "unary"
  }
  server {
    service: "TireStatus"
    channel: "tire-status-server-stream"
    service_unit_name: "server-stream"
  }
  server {
    service: "TireStatus"
    channel: "tire-status-client-stream"
    service_unit_name: "client-stream"
  }
  server {
    service: "TireStatus"
    channel: "tire-status-twice"
    service_unit_name: "twice"
  }
}

service_bundle {
  name: "TireStatusConsumer"
  client {
    service: "TireStatus"
    channel: "tire-status-unary"
  }
  client {
    service: "TireStatus"
    channel: "tire-status-server-stream"
  }
  client {
    service: "TireStatus"
    channel: "tire-status-client-stream"
  }
}
