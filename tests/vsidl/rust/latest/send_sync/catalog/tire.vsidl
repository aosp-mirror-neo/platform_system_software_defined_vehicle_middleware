# proto-file: system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.vsidl.sendsync.test"

service_bundle {
  name: "BundleOne"

  publisher {
    message: "TirePressure"
    topic: "front-left"
    capacity: 8
  }

  subscriber {
    message: "TirePressure"
    topic: "front-right"
  }

  server {
    service: "OtherTireStatus"
    channel: "other-tire-status"
  }

  client {
    service: "TireStatus"
    channel: "tire-status"
  }
}

service_bundle {
  name: "BundleTwo"

  publisher {
    message: "sdv.vsidl.sendsync.test.TirePressure"
    topic: "front-right"
    capacity: 8
  }

  subscriber {
    message: "sdv.vsidl.sendsync.test.TirePressure"
    topic: "front-left"
  }

  server {
    service: "TireStatus"
    channel: "tire-status"
  }

  client {
    service: "OtherTireStatus"
    channel: "other-tire-status"
  }
}
