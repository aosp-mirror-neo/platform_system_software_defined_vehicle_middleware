package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libvsidl_multipub_test",
    crate_name: "vsidl_multipub_test",
    protos: [
        "**/*.proto",
    ],
    source_stem: "vsidl_multipub_test_source",
    rustlibs: [
        "libvsidl_v1_stdlib_proto_rs",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

filegroup {
    name: "catalog_multipub_test",
    srcs: ["**/*"],
}
