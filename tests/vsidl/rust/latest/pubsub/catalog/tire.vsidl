# proto-message: VsidlEntry

package: "sdv.vsidl.pubsub.test"

service_bundle {
  name: "PublishingBundle"

  publisher {
    message: "TirePressure"
    channel: "channel_zero"
    channel: "channel_one"
    channel: "channel_two"
    channel: "channel_three"
    channel: "channel_four"
    channel: "channel_five"
    channel: "channel_six"
    channel: "channel_seven"
    channel: "channel_eight"
    channel: "channel_nine"
    channel: "channel_ten"
    channel: "channel_eleven"
    channel: "channel_twelve"
    channel: "channel_thirteen"
    channel: "channel_fourteen"
    channel: "channel_fifteen"
    capacity: 8
  }
}

service_bundle {
  name: "SubscribingBundle"

  subscriber {
    message: "sdv.vsidl.pubsub.test.TirePressure"
  }
}
