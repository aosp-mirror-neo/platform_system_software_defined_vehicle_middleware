package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "crypto_rpc@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
    ],
    crate_name: "crypto_rpc",
    rustlibs: [
        "libanyhow",
        "libdata_encoding",
        "liblog_rust",
        "librand",
        "libsdv_status_rs",
    ],
    target: {
        host: {
            rlibs: ["libopenssl_static"],
        },
        android: {
            rustlibs: ["libopenssl"],
        },
    },
}

rust_library {
    name: "libcrypto_rpc_rs",
    defaults: [
        "crypto_rpc@rust_defaults",
    ],
    srcs: ["src/lib.rs"],
    min_sdk_version: "34",
    product_available: true,
    vendor_available: true,
    host_supported: true,
}

rust_test {
    name: "sdv_core_middleware_unit_libcrypto_rpc_test",
    defaults: ["crypto_rpc@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],

    test_options: {
        unit_test: true,
    },
    ld_flags: ["-Wl,--no-as-needed"],

    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
