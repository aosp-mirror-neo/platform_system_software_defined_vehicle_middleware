package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "native_services_names@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    rustlibs: [
        "google.sdv.identity-V2-rust",
        "libanyhow",
        "libsdv_aid",
        "libsdv_comms_id",
    ],
}

rust_library {
    name: "libnative_services_names",
    crate_name: "native_services_names",
    defaults: ["native_services_names@rust_defaults"],
    visibility: ["//system/software_defined_vehicle:__subpackages__"],
    system_ext_specific: true,
    vendor_available: true,
    min_sdk_version: "35",
}

rust_library {
    name: "libnative_services_names_for_test",
    crate_name: "native_services_names",
    features: ["test-util"],
    defaults: ["native_services_names@rust_defaults"],
    visibility: ["//system/software_defined_vehicle:__subpackages__"],
}

rust_test {
    name: "sdv_core_middleware_unit_native_services_names_test",
    defaults: ["native_services_names@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: true,
    },
}

rust_bindgen {
    name: "libsdv_aid",
    wrapper_src: "rust_bindgen/android_filesystem_config_wrapper.h",
    crate_name: "sdv_aid",
    source_stem: "bindings",
    header_libs: ["libcutils_headers"],
    bindgen_flags: [
        "--allowlist-var",
        "AID_ROOT",
        "--allowlist-var",
        "AID_SYSTEM",
        "--allowlist-var",
        "AID_SYSTEM_EXT_RESERVED_START",
        "--allowlist-var",
        "AID_SYSTEM_EXT_RESERVED_END",
        "--allowlist-var",
        "AID_PRODUCT_RESERVED_START",
        "--allowlist-var",
        "AID_PRODUCT_RESERVED_END",
        "--allowlist-var",
        "AID_OEM_RESERVED_START",
        "--allowlist-var",
        "AID_OEM_RESERVED_END",
    ],
    visibility: ["//system/software_defined_vehicle:__subpackages__"],
    system_ext_specific: true,
    vendor_available: true,
    min_sdk_version: "35",
}
