package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_connectivity_telemetry",
}

rust_defaults {
    name: "sdv_wire_format_defaults",
    srcs: [
        "src/lib.rs",
    ],
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        // keep-sorted start
        "libanyhow",
        "libprotobuf",
        "libsdv_vsidl_common",
        "libthiserror",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_library {
    name: "libsdv_wire_format",
    crate_name: "sdv_wire_format",
    defaults: ["sdv_wire_format_defaults"],
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_middleware_unit_wire_format_test",
    defaults: ["sdv_wire_format_defaults"],
    test_options: {
        unit_test: true,
    },
    rustlibs: [
        // keep-sorted start
        "libprotobuf_parse",
        "libtempfile",
        // keep-sorted end
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
}
