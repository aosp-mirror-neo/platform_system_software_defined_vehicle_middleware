package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library {
    name: "libsdv_dt_core",
    product_available: true,
    vendor_available: true,
    system_ext_specific: true,
    srcs: ["src/libsdv_dt_core.cpp"],
    export_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
    ],
    min_sdk_version: "35",
}

cc_test {
    name: "sdv_core_middleware_libsdv_dt_core_test",
    srcs: [
        "tests/libsdv_dt_core_test.cpp",
    ],
    local_include_dirs: [
        "src",
        "tests",
    ],
    static_libs: [
        "libsdv_dt_core",
        "libbase",
        "libgtest",
        "libgmock",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
        "libutils",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
