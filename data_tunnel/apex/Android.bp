package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// SDV Data Tunnel agent's companion APEX with corresponding ACLs to control
// communication between SDV Data Tunnel agents on different VMs.
//
// TODO(b/383305439): this will be move to a designated /etc folder in the future.
apex {
    name: "google.sdv.dt",
    manifest: "apex_manifest.json",
    key: "google.sdv.dt.key",
    file_contexts: "file_contexts",
    updatable: false,
    prebuilts: [
        // SDV Manifest - used by SBR
        "google.sdv.dt.manifest",
        // ACL Policy
        "google.sdv.dt.acl_policy",
    ],
    system_ext_specific: true,
}

apex_key {
    name: "google.sdv.dt.key",
    public_key: "google.sdv.dt.avbpubkey",
    private_key: "google.sdv.dt.pem",
}

// SDV manifest file with the Data Tunnel agent acls only, which are required
// for internal SDV functionality.
prebuilt_etc {
    name: "google.sdv.dt.manifest",
    // The source name of the manifest file.
    src: "data_tunnel_manifest.textproto",
    // The name of the installed file shall be `sdv_service_bundles_manifest.textproto`.
    filename: "sdv_service_bundles_manifest.textproto",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of SDV Data Tunnel is stored in the apex.
prebuilt_etc {
    name: "google.sdv.dt.acl_policy",
    // The source name of the ACL file.
    src: "acl.textproto",
    filename: "acl.textproto",
    // Disable direct installation of the file to one of the partitions.
    // The file will be used only inside of service bundles registry apexes.
    installable: false,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: ["//visibility:private"],
}

// File with the ACL policy of SDV Data Tunnel is stored in the /etc folder.
prebuilt_etc {
    name: "sdv_dt_agent_acl_textproto",
    sub_dir: "sdv_authz_acls/google.sdv.dt",
    src: "acl.textproto",
    filename: "IDataTunnelAgent.textproto",
    system_ext_specific: true,
    // Reduce prebuilt visibility to avoid adding it in another APEX.
    visibility: [
        "//system/software_defined_vehicle/sdv_gateway/sdv_comms_for_ivi",
        "//device/google/sdv",
    ],
}
