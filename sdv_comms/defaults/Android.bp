package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
    default_visibility: [
        "//device/google/sdv",
        "//hardware/sdv:__subpackages__",
        "//system/software_defined_vehicle/middleware:__subpackages__",
    ],
}

// Defaults to be used for SDV Comms Internal API.
rust_defaults {
    name: "sdv_comms_internal@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    system_ext_specific: true,
    visibility: [
        "//system/software_defined_vehicle/middleware/sdv_comms:__subpackages__",
        "//system/software_defined_vehicle/core_services/lifecycle_management/service_bundle_runner",
    ],
}

// Defaults to be used for SDV Comms Internal API.
rust_defaults {
    name: "sdv_comms_ffi@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    system_ext_specific: true,
    visibility: [
        "//system/software_defined_vehicle/middleware/sdv_comms:__subpackages__",
        "//system/software_defined_vehicle/core_services/lifecycle_management/service_bundle_runner",
        "//system/software_defined_vehicle/core_services/sdv_comms_for_ivi/samples_apex",
    ],
    vendor_available: true,
}

// Defaults to be used for SDV Comms FFI Stubs.
rust_defaults {
    name: "sdv_comms_stub@rust_defaults",
    defaults: [],
    prefer_rlib: true,
    installable: false,
    product_available: true,
    vendor_available: true,
    rustlibs: ["liblibc"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    visibility: [
        "//system/software_defined_vehicle/middleware/sdv_comms:__subpackages__",
        "//system/software_defined_vehicle/service_bundles_registry/clientlib",
        "//system/software_defined_vehicle/samples/sdv_gateway/dt",
    ],
}

// Defaults to be used for Comms SDK Rust API.
rust_defaults {
    name: "sdv_comms_sdk@rust_defaults",
    system_ext_specific: true,
    product_available: true,
    vendor_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}

cc_defaults {
    name: "sdv_comms_sdk@cc_defaults",
    system_ext_specific: true,
    product_available: true,
    vendor_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}
