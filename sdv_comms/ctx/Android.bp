package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "sdv_comms_ctx@rust_defaults",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "google.sdv.comms-V2-rust",
        "google.sdv.data_tunnel-V2-rust",
        "google.sdv.rpc-V2-rust",
        "google.sdv.service_discovery.discovery-V2-rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libbytemuck",
        "libfutures_executor",
        "libtokio",
        "libsdv_comms_common",
        "libsdv_comms_id",
        "libsdv_status_rs",
    ],
    proc_macros: [
        "libsdv_comms_stack_ffi_macro",
        "libpaste",
    ],
    defaults_visibility: ["//visibility:private"],
}

rust_library {
    name: "libsdv_comms_ctx_impl",
    crate_name: "sdv_comms_ctx",
    defaults: [
        "sdv_comms_internal@rust_defaults",
        "sdv_comms_ctx@rust_defaults",
    ],
    min_sdk_version: "35",
    // Made public for OEM and Telemetry to call `wait_for_agents` (to prevent
    // crashes on context creation).
    visibility: ["//visibility:public"],
    // Made available to vendor for OEM and Telemetry to call `wait_for_agents`
    // (to prevent crashes on context creation).
    vendor_available: true,
    product_available: true,
}

rust_ffi {
    name: "libsdv_comms_ctx_ffi",
    crate_name: "sdv_comms_ctx",
    stem: "libsdv_comms_ctx_ffi",
    defaults: [
        "sdv_comms_ffi@rust_defaults",
        "sdv_comms_ctx@rust_defaults",
    ],
    cfgs: ["comms_stack_ffi"],
    visibility: ["//device/google/sdv"],
}

rust_ffi {
    name: "libsdv_comms_ctx_stub",
    crate_name: "sdv_comms_ctx",
    stem: "libsdv_comms_ctx_ffi",
    srcs: ["src/stub.rs"],
    defaults: ["sdv_comms_stub@rust_defaults"],
    cfgs: ["comms_stack_stub"],
    rustlibs: [
        "libsdv_comms_common",
        "libsdv_comms_id_stub",
        "libsdv_status_rs",
    ],
    apex_exclude: true,
    proc_macros: ["libsdv_comms_stack_ffi_macro"],
    visibility: ["//system/software_defined_vehicle/middleware:__subpackages__"],
}
