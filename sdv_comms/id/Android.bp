package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_comms_id@rust_defaults",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "google.sdv.identity-V2-rust",
        "libbinder_rs",
        "libsdv_status_rs",
        "libsdv_comms_common",
        "libthiserror",
        "libsdv_comms_id_validator",
    ],
    proc_macros: ["libsdv_comms_stack_ffi_macro"],
    defaults_visibility: ["//visibility:private"],
}

rust_library {
    name: "libsdv_comms_id_validator",
    crate_name: "sdv_comms_id_validator",
    srcs: ["src/validator/lib.rs"],
    rustlibs: ["libthiserror"],
    defaults: ["sdv@rust_defaults"],
    vendor_available: true,
    product_available: true,
    host_supported: true,
    min_sdk_version: "35",
}

rust_library {
    name: "libsdv_comms_id",
    crate_name: "sdv_comms_id",
    defaults: [
        "sdv_comms_internal@rust_defaults",
        "sdv_comms_id@rust_defaults",
    ],
    rustlibs: [],
    visibility: [
        "//system/software_defined_vehicle/middleware:__subpackages__",
        // Allows Service Bundle Registry to use service bundle and package names verifications.
        "//system/software_defined_vehicle/service_bundles_registry:__subpackages__",
        // Allows Lifecycle manager to use FQIN API.
        "//system/software_defined_vehicle/core_services/lifecycle_management:__subpackages__",
        // Allows sdv_service cli tool to access FQIN API
        "//system/software_defined_vehicle/samples/service_bundles_lifecycle/sdv_service:__subpackages__",
        "//device/google/sdv",
        "//hardware/sdv:__subpackages__",
        "//system/software_defined_vehicle/lifecycle_management:__subpackages__",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

rust_ffi {
    name: "libsdv_comms_id_ffi",
    crate_name: "sdv_comms_id",
    stem: "libsdv_comms_id_ffi",
    defaults: [
        "sdv_comms_ffi@rust_defaults",
        "sdv_comms_id@rust_defaults",
    ],
    cfgs: ["comms_stack_ffi"],
    // TODO(b/329859325): Make this visible to the Lifecycle Manager for initialisation
    visibility: ["//device/google/sdv"],
}

rust_ffi {
    name: "libsdv_comms_id_stub",
    crate_name: "sdv_comms_id",
    stem: "libsdv_comms_id_ffi",
    defaults: ["sdv_comms_stub@rust_defaults"],
    srcs: ["src/stub.rs"],
    cfgs: ["comms_stack_stub"],
    rustlibs: [
        "libsdv_status_rs",
        "libsdv_comms_common",
    ],
    apex_exclude: true,
    proc_macros: ["libsdv_comms_stack_ffi_macro"],
    visibility: [
        "//hardware/sdv:__subpackages__",
        "//system/software_defined_vehicle/lifecycle_management:__subpackages__",
        "//system/software_defined_vehicle/middleware:__subpackages__",
    ],
}

rust_test {
    name: "sdv_core_middleware_unit_comms_id_test",
    crate_name: "sdv_comms_id",
    defaults: [
        "sdv@rust_defaults",
        "sdv_comms_id@rust_defaults",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}

rust_test {
    name: "sdv_core_middleware_unit_comms_id_validator_test",
    srcs: ["src/validator/lib.rs"],
    rustlibs: ["libthiserror"],
    defaults: ["sdv@rust_defaults"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
    ],
}
