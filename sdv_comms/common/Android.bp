package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
    default_visibility: [
        "//hardware/sdv:__subpackages__",
        "//system/software_defined_vehicle/middleware/sdv_comms:__subpackages__",
    ],
}

rust_library {
    name: "libsdv_comms_common",
    crate_name: "sdv_comms_common",
    defaults: [
        "sdv@rust_defaults",
        "sdv_comms_sdk@rust_defaults",
    ],
    srcs: ["src/lib.rs"],
    rustlibs: [
        // keep-sorted start
        "libcfg_if",
        "libfutures",
        "liblog_rust",
        "libsdv_status_rs",
        "libstatic_assertions",
        // keep-sorted end
    ],
    proc_macros: ["libpaste"],
    min_sdk_version: "34",
    visibility: [
        "//system/software_defined_vehicle/middleware/sdv_comms:__subpackages__",
    ],
}

rust_test {
    name: "sdv_core_core_services_unit_comms_common_test",
    crate_name: "sdv_comms_common",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    rustlibs: [
        // keep-sorted start
        "libcfg_if",
        "libfutures",
        "liblog_rust",
        "libsdv_status_rs",
        "libstatic_assertions",
        "libtokio",
        // keep-sorted end
    ],
    proc_macros: ["libpaste"],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
