package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
    default_visibility: ["//system/software_defined_vehicle/middleware:__subpackages__"],
}

rust_defaults {
    name: "sdv_comms_dt@rust_defaults",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "android.hardware.common.fmq-V1-rust",
        "google.sdv.data_tunnel-V2-rust",
        "google.sdv.service_discovery.discovery-V2-rust",
        "google.sdv.service_discovery.common-V2-rust",
        "google.sdv.identity-V2-rust",
        "libbinder_rs",
        "liblazy_static",
        "liblog_rust",
        "libbytemuck",
        "libfutures",
        "libparking_lot",
        "libsdv_comms_common",
        "libsdv_comms_ctx_impl",
        "libsdv_comms_id",
        "libsdv_comms_sd",
        "libsdv_fmq_rust",
        "libsdv_status_rs",
        "libzerocopy",
        "libonce_cell",
    ],
    proc_macros: ["libsdv_comms_stack_ffi_macro"],
    defaults_visibility: ["//visibility:private"],
}

cc_library {
    name: "libfmq_wrapper",
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
        "libfmq",
        "android.hardware.common.fmq-V1-ndk",
    ],
    srcs: [
        "fmq_wrapper/FmqWrapper.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "29",
    host_supported: true,
}

rust_bindgen {
    name: "libsdv_fmq_bindgen",
    crate_name: "sdv_fmq_bindgen",
    edition: "2021",
    wrapper_src: "fmq_wrapper/FmqWrapper.hpp",
    source_stem: "bindings",
    bindgen_flags: [
        "--no-recursive-allowlist",
        "--use-core",
        "--ctypes-prefix=core::ffi",
        "--raw-line=#![no_std]",
        "--raw-line=pub use android_hardware_common_fmq::aidl::android::hardware::common::fmq::{MQDescriptor::MQDescriptor, UnsynchronizedWrite::UnsynchronizedWrite, SynchronizedReadWrite::SynchronizedReadWrite, GrantorDescriptor::GrantorDescriptor};",
        "--raw-line=pub use android_hardware_common::{aidl::android::hardware::common::NativeHandle::NativeHandle, binder::ParcelFileDescriptor};",
        "--raw-line=#[repr(C)]",
        "--raw-line=pub struct aidl_android_hardware_common_fmq_GrantorDescriptor {",
        "--raw-line=    pub fdIndex: i32,",
        "--raw-line=    pub offset: i32,",
        "--raw-line=    pub extent: i64,",
        "--raw-line=}",
        "--raw-line=use std::os::android::raw::off_t;",
        "--raw-line=use libc::FILE;",
        "--opaque-type=AidlMQDesc",
        "--opaque-type=.*AidlMessageQueue",
        "--with-derive-default",
        "--no-default=MessageQueueDesc",
        "--no-default=FmqWrapper",
        "--allowlist-function=convertGrantor",
        "--allowlist-function=convertDesc",
        "--allowlist-function=freeDesc",
        "--allowlist-type=ndk::ScopedFileDescriptor",
        "--allowlist-function=descGrantors",
        "--allowlist-function=descNumGrantors",
        "--allowlist-function=descHandleFDs",
        "--allowlist-function=descHandleNumFDs",
        "--allowlist-function=descHandleInts",
        "--allowlist-function=descHandleNumInts",
        "--allowlist-function=descQuantum",
        "--allowlist-function=descFlags",
        "--allowlist-type=\\bFmqWrapper",
        "--allowlist-type=\\bAidlMQDesc",
        "--allowlist-type=\\bMemTransaction",
        "--allowlist-type=.*MemTransaction.*MemRegion.*",
        "--blocklist-type=std::.+",
        "--blocklist-function=*android_log*",
        "--allowlist-function=.*FmqWrapper.*",
        "--allowlist-function=.*write",
        "--allowlist-function=.*read",
        "--allowlist-function=.*skipMessages",
        "--allowlist-function=.*isValid",
        "--allowlist-function=.*availableToRead",
        "--allowlist-type=logger_list",
        "--allowlist-type=log_msg",
        "--allowlist-type=logger_entry",
    ],
    rustlibs: [
        "android.hardware.common.fmq-V1-rust",
        "android.hardware.common-V2-rust",
        "liblibc",
    ],
    whole_static_libs: [
        "libfmq_wrapper",
    ],
    shared_libs: [
        "libc++",
        "liblog",
        "libcutils",
        "libfmq",
        "android.hardware.common.fmq-V1-ndk",
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_fmq_rust",
    crate_name: "sdv_fmq_rust",
    srcs: ["fmq_wrapper/fmq_wrapper.rs"],
    rustlibs: [
        "android.hardware.common.fmq-V1-rust",
        "libsdv_fmq_bindgen",
        "liblog_rust",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libfmq",
        "libcutils",
        "android.hardware.common.fmq-V1-ndk",
    ],
    vendor_available: true,
}

rust_library {
    name: "libsdv_comms_dt",
    crate_name: "sdv_comms_dt",
    defaults: [
        "sdv_comms_internal@rust_defaults",
        "sdv_comms_dt@rust_defaults",
    ],
    visibility: [
        "//device/google/sdv",
    ],
}

rust_ffi {
    name: "libsdv_comms_dt_ffi",
    crate_name: "sdv_comms_dt",
    stem: "libsdv_comms_dt_ffi",
    defaults: [
        "sdv_comms_ffi@rust_defaults",
        "sdv_comms_dt@rust_defaults",
    ],
    cfgs: ["comms_stack_ffi"],
    visibility: [
        "//device/google/sdv",
    ],
}

rust_ffi {
    name: "libsdv_comms_dt_stub",
    crate_name: "sdv_comms_dt",
    stem: "libsdv_comms_dt_ffi",
    srcs: ["src/stub.rs"],
    defaults: ["sdv_comms_stub@rust_defaults"],
    cfgs: ["comms_stack_stub"],
    rustlibs: [
        "libsdv_comms_common",
        "libsdv_comms_ctx_stub",
        "libsdv_comms_id_stub",
        "libsdv_comms_sd_stub",
        "libsdv_status_rs",
    ],
    apex_exclude: true,
    proc_macros: ["libsdv_comms_stack_ffi_macro"],
}

rust_test {
    name: "sdv_core_middleware_unit_comms_dt_fmq_wrapper_test",
    srcs: ["fmq_wrapper/fmq_wrapper.rs"],
    rustlibs: [
        "android.hardware.common.fmq-V1-rust",
        "libsdv_fmq_bindgen",
        "liblog_rust",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libfmq",
        "libcutils",
        "android.hardware.common.fmq-V1-ndk",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    require_root: true,
}

rust_test {
    name: "sdv_core_middleware_unit_comms_dt_test",
    defaults: [
        "sdv_comms_internal@rust_defaults",
        "sdv_comms_dt@rust_defaults",
    ],
    rustlibs: [
        "libnix",
        "libtokio",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    // TODO(398771552): Remove authz disabling exception. This should not be used in the new code.
    test_config_template: ":sdv_authz_enforcement_flag_disabled_config_template",
    require_root: true,
}
