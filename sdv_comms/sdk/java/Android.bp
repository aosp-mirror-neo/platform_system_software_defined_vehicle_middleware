java_defaults {
    name: "libsdv_comms_java@java_defaults",
    srcs: ["src/**/*.java"],
}

java_library {
    name: "libsdv_comms_java",
    defaults: [
        "libsdv_comms_java@java_defaults",
    ],
}

android_test {
    name: "sdv_core_middleware_unit_comms_java_sdk_test",
    defaults: ["libsdv_comms_java@java_defaults"],
    srcs: ["tests/**/*.java"],
    static_libs: [
        "androidx.test.runner",
        "libsdv_comms_java",
        "truth",
    ],
    manifest: "tests/AndroidManifest.xml",
    test_options: {
        unit_test: true,
    },
    test_config: "tests/AndroidTest.xml",
}
