package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

// Communication Agent defaults to be used by libraries, tests and binaries.
rust_defaults {
    name: "communication_agent@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "communication_agent",
    rustlibs: [
        "libsdv_log_rust",
        "libsdv_status_rs",
        "libanyhow",
        "libsdv_comms_rs",
        "librand",
    ],
    prefer_rlib: true,
}

rust_test {
    name: "sdv_core_middleware_unit_communication_agent_test",
    defaults: ["communication_agent@rust_defaults"],
    srcs: ["src/lib.rs"],
    test_suites: [
        // keep-sorted start
        "automotive-sdv-tests",
        "general-tests",
        // keep-sorted end
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    auto_gen_config: true,
    test_options: {
        unit_test: true,
    },
}
