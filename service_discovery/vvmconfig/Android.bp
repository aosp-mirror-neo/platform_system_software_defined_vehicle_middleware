package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_license"],
}

rust_defaults {
    name: "vvmconfig@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    host_supported: true,
    rustlibs: [
        "libanyhow",
        "libbase64_rust",
        "libciborium",
        "libcoset",
        "libdice_policy",
        "libhwtrust",
        "libserde",
    ],
}

rust_library {
    name: "libvvmconfig",
    crate_name: "vvmconfig",
    defaults: ["vvmconfig@rust_defaults"],
    vendor_available: true,
    min_sdk_version: "35",
}

rust_test_host {
    name: "sdv_core_middleware_unit_libvvmconfig_test",
    defaults: ["vvmconfig@rust_defaults"],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
        "sdv-host-unit-tests",
    ],
    test_options: {
        unit_test: true,
    },
    rustlibs: [
        "libserde_json",
    ],
}
