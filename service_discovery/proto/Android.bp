package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libsdv_sd_mesh_api",
    crate_name: "sdv_sd_mesh_api",
    grpc_protos: [
        "sdv_sd_mesh/api/sdv_sd_mesh.proto",
    ],
    protos: [
        "sdv_sd_mesh/api/service_discovery/*.proto",
        "sdv_sd_mesh/api/identity/*.proto",
    ],
    rustlibs: ["libsdv_authz_policy_proto_rust"],
    source_stem: "sdv_sd_mesh",
    vendor_available: true,
    min_sdk_version: "35",
}
