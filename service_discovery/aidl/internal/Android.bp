package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "google.sdv.identity.internal",
    system_ext_specific: true,
    vendor_available: true,
    visibility: [
        "//system/software_defined_vehicle:__subpackages__",
        "//system/tools/aidl/build",
    ],
    srcs: ["google/sdv/identity/internal/*.aidl"],
    imports: [
        "google.sdv.identity-V2",
    ],
    owner: "google",
    frozen: false,
    min_sdk_version: "35",
    backend: {
        java: {
            enabled: false,
        },
        rust: {
            // Enabled because this interface is implemented by an IVI or SDV
            // core service and is consumed by service discovery.
            enabled: true,
            gen_mockall: true,
            additional_rustlibs: [
                "libmockall",
            ],
        },
        ndk: {
            // Enabled because this interface is implemented by an IVI or SDV
            // core service and is consumed by service discovery.
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
    // No vintf stability since this is an internal SDV API without cross partition calls.
}
