package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Note: This library is available in the binary PDK.
// See system/software_defined_vehicle/platform/binary_pdk/conf.py
rust_library {
    name: "libuds_certs",
    crate_name: "uds_certs",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    // WARNING: Only add rust libs that are also available in the binary PDK.
    // Ie, they must be available as source code in the binary PDK.
    rustlibs: [
        "libanyhow",
        "libciborium",
        "libcoset",
        "libhex",
        "libhwtrust",
    ],
    target: {
        host: {
            rlibs: ["libopenssl_static"],
        },
        android: {
            rustlibs: ["libopenssl"],
        },
    },
    product_available: true,
    vendor_available: true,
    host_supported: true,
    min_sdk_version: "35",
}

filegroup {
    name: "libuds_certs_sources",
    srcs: ["src/*.rs"],
}
