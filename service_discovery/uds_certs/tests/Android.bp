// Note: tests for libuds_certs are put in a separate directory as they have
// rust library dependencies that are not available in the binary PDK.
// Therefore even though libuds_certs is in the binary PDK, its tests are not.

package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["sdv_license"],
}

// Note: Have the test target definition in a separate Android.bp file as well
// for the following reasons:
// * It would be confusing to have a target in the Android.bp file that you
//   cannot build or see the sources it refers to (from the perspective of a
//   binary PDK user).
// * Avoid leaking rust lib names that do not exist in the binary PDK.
rust_test {
    name: "sdv_core_core_services_unit_libuds_certs_tests",
    crate_root: "uds_certs_tests.rs",
    srcs: [":libuds_certs_sources"],
    defaults: [
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libanyhow",
        "libciborium",
        "libcoset",
        "libcrypto_rpc_rs",
        "libhex",
        "libhwtrust",
        "libopenssl",
        "libsample_dice_handover",
        "libtest_uds_certs_generator",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
