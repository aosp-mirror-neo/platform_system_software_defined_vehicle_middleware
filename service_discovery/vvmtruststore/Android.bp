package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libvvmtruststore@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libanyhow",
        "libciborium",
        "libcoset",
        "libcrypto_rpc_rs",
        "libhwtrust",
        "libhwtrust_private_key",
        "liblog_rust",
        "libserde",
        "libuds_certs",
    ],
    target: {
        host: {
            rlibs: ["libopenssl_static"],
        },
        android: {
            rustlibs: ["libopenssl"],
        },
    },
}

rust_library {
    name: "libvvmtruststore",
    crate_name: "vvmtruststore",
    defaults: ["libvvmtruststore@rust_defaults"],
    vendor_available: true,
    host_supported: true,
    min_sdk_version: "35",
}

// TODO: b/391816382 - move this a separate module in tools/ once the openssl library is visible
//       there
rust_library {
    name: "libtest_uds_certs_generator",
    crate_name: "test_uds_certs_generator",
    defaults: ["sdv@rust_defaults"],
    srcs: ["testing/test_uds_certs_generator.rs"],
    rustlibs: [
        "libanyhow",
        "libcoset",
        "libcrypto_rpc_rs",
        "libdiced_open_dice_multialg",
        "libhex",
        "libhwtrust",
        "libsample_dice_handover",
        "libtest_dice_artifacts_builder",
        "libvvmtruststore",
    ],
    target: {
        host: {
            rlibs: ["libopenssl_static"],
        },
        android: {
            rustlibs: ["libopenssl"],
        },
    },
    host_supported: true,
}

rust_test {
    name: "sdv_core_middleware_unit_libvvmtruststore_tests",
    crate_name: "libvvmtruststore",
    defaults: [
        "libvvmtruststore@rust_defaults",
        "sdv_sd@rust_defaults",
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libdiced_open_dice_multialg",
        "libsample_dice_handover",
        "libtest_uds_certs_generator",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
