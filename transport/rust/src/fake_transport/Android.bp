package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_mw_local_comms_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libfutures",
        "libsdv_comms_rs",
        "libsdv_mw_rs_comms",
        "libsdv_status_rs",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_library {
    name: "libsdv_mw_local_comms",
    crate_name: "sdv_mw_local_comms",
    defaults: ["sdv_mw_local_comms_defaults"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_core_services_unit_middleware_local_comms_test",
    defaults: ["sdv_mw_local_comms_defaults"],
    test_suites: [
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: true,
    },
    rustlibs: [
        "libgoogletest_rust",
        "libsdv_mw_commstests_protos",
        "libtokio",
    ],
}
