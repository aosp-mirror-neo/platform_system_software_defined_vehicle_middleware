package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Aconfig Declarations Library
aconfig_declarations {
    name: "sdv_middleware_flags",
    package: "com.android.sdv.middleware.flags",
    container: "system_ext",
    srcs: ["flags.aconfig"],
}

// Aconfig Codegen Library
rust_aconfig_library {
    name: "libsdv_middleware_flags",
    crate_name: "sdv_middleware_flags",
    aconfig_declarations: "sdv_middleware_flags",
    vendor_available: true,
    min_sdk_version: "35",
}
